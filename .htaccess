Options -Indexes
RewriteEngine On

# Redirect all HTTP traffic to HTTPS.
# Remove this block only if SSL is terminated by a reverse proxy (use X-Forwarded-Proto checks there instead).
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "*.sql">
    Order Allow,Deny
    Deny from all
</Files>
<Files "install.php">
    Order Allow,Deny
    Deny from all
</Files>

# ── Security headers ──────────────────────────────────────────────────────────
# Tell browsers to always use HTTPS for this domain for one year.
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Restrict access to browser features not used by this app.
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

# Content Security Policy.
# - script-src / style-src: 'unsafe-inline' is required because the app uses
#   inline <script> blocks and style="..." attributes throughout.
# - img-src data: allows QR-code canvas.toDataURL() output.
# - img-src blob: allows Blob-based image URLs if used.
# - frame-src 'self': required for the hidden iframe used for label printing.
# - form-action 'self': prevents form submissions to external sites.
# - object-src / base-uri 'none': blocks plugins and base-tag hijacking.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"

# Remove headers that reveal server technology details.
Header always unset X-Powered-By
Header always unset Server

# ── PHP settings ──────────────────────────────────────────────────────────────
php_flag display_errors off
php_flag log_errors on

# Secure session cookies: only sent over HTTPS, not accessible via JavaScript,
# and scoped to same-site requests to mitigate CSRF.
php_value session.cookie_httponly 1
php_value session.cookie_secure   1
php_value session.cookie_samesite "Lax"
php_value session.use_strict_mode 1
